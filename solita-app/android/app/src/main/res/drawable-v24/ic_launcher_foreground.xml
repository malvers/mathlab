<?xml version="1.0" encoding="utf-8"?>
<!-- Doc Alvers Tracker adaptive-icon foreground: the GPS trail + markers from HTML/tracker/icon.svg.
     The 64-unit source artwork is centred into the 108-unit adaptive canvas and scaled so its
     diagonal extremes (green start dot ↔ red position marker) stay inside the safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.1"
        android:scaleY="1.1"
        android:translateX="17.6"
        android:translateY="21.1">
        <!-- winding GPS trail (orange) -->
        <path
            android:pathData="M16,48 C24,44 22,34 30,30 C38,26 38,18 46,16"
            android:fillColor="#00000000"
            android:strokeColor="#F5C242"
            android:strokeWidth="4.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- start point (green) -->
        <path
            android:fillColor="#799E31"
            android:pathData="M16,48 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z" />
        <!-- current position marker (red with white ring) -->
        <path
            android:fillColor="#B02418"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.5"
            android:pathData="M46,16 m-7.5,0 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0 Z" />
    </group>
</vector>
