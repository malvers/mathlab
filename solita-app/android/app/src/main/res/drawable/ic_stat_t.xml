<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar notification small-icon for the background-recording foreground service.
     A lowercase "t" silhouette, enlarged to fill more of the 24dp canvas (bigger in the
     status bar). Android renders status-bar icons as a white alpha mask, so this is a flat
     white glyph (the cyan tint applies only to the expanded notification via
     capacitor_background_geolocation_notification_color). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- crossbar -->
    <path android:fillColor="#FFFFFF" android:pathData="M4,6 h16 v3.5 h-16 z" />
    <!-- stem + foot -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M10,2 h4 v14 c0,1.4 0.7,2.1 2.1,2.1 h1.9 v3.6 h-2.5 c-3.7,0 -5.6,-2 -5.6,-5.7 z" />
</vector>
