[
 {"nr": 59, "text": "Eine Reise von tausend Meilen beginnt mit einem <b>einzigen Schritt</b>.", "wer": "Laozi", "rolle": "Daodejing · China, 6. Jh. v. Chr.", "bild": {"datei": "59.jpg", "titel": "File:Chen Hongshou - Paintings after Ancient Masters, Laozi Riding an Ox - 1979.27.1.2 - Cleveland Museum of Art.tiff", "lizenz": "Public domain", "credit": "Chen Hongshou", "seite": "https://commons.wikimedia.org/wiki/File%3AChen_Hongshou_-_Paintings_after_Ancient_Masters%2C_Laozi_Riding_an_Ox_-_1979.27.1.2_-_Cleveland_Museum_of_Art.tiff", "zugeschnitten": "Sicherung: ~/.claude/projects/-Users-malvers-IdeaProjects-forloop/memory/handoff-files/weisheiten/bilder-beschnitten/"}},
 {"nr": 60, "text": "Willst du <b>schnell</b> gehen, geh allein.<br>Willst du <b>weit</b> gehen, geht gemeinsam.", "wer": "Sprichwort aus Afrika", "rolle": "", "bild": {"datei": "60.jpg", "titel": "File:The African savanna elephants across at Saadani National Park Tanzania.jpg", "lizenz": "CC BY-SA 4.0", "credit": "Rasheedhrasheed", "seite": "https://commons.wikimedia.org/wiki/File%3AThe_African_savanna_elephants_across_at_Saadani_National_Park_Tanzania.jpg"}},
 {"nr": 61, "text": "Sieben Mal fallen,<br><b>acht Mal</b> aufstehen.", "wer": "Sprichwort aus Japan", "rolle": "七転び八起き · nana korobi ya oki", "bild": {"datei": "61.png", "titel": "File:Daruma doll, cut out, 03.jpg", "lizenz": "Public domain", "credit": "Crisco 1492", "seite": "https://commons.wikimedia.org/wiki/File%3ADaruma_doll%2C_cut_out%2C_03.jpg"}},
 {"nr": 62, "text": "Es scheint immer <b>unmöglich</b> — bis es getan ist.", "wer": "Nelson Mandela", "rolle": "Freiheitskämpfer und Präsident, Südafrika", "bild": {"datei": "62.png", "titel": "File:Cape Town City Bowl and Table Mountain at dawn.jpg", "lizenz": "CC BY-SA 3.0", "credit": "Daniel Case", "seite": "https://commons.wikimedia.org/wiki/File%3ACape_Town_City_Bowl_and_Table_Mountain_at_dawn.jpg"}},
 {"nr": 63, "text": "Wer <b>fragt</b>, ist ein Narr für fünf Minuten.<br>Wer <b>nicht fragt</b>, bleibt ein Narr für immer.", "wer": "Sprichwort aus China", "rolle": "oft Konfuzius zugeschrieben", "bild": {"datei": "63.jpg", "titel": "File:Cropped version of Confucius Portrait, Kongzi (Confucius) Family Mansion, Qufu (13044335945).jpg", "lizenz": "Public domain", "credit": "Unknown authorUnknown author", "seite": "https://commons.wikimedia.org/wiki/File%3ACropped_version_of_Confucius_Portrait%2C_Kongzi_%28Confucius%29_Family_Mansion%2C_Qufu_%2813044335945%29.jpg", "zugeschnitten": "Sicherung: ~/.claude/projects/-Users-malvers-IdeaProjects-forloop/memory/handoff-files/weisheiten/bilder-beschnitten/"}},
 {"nr": 64, "text": "Die beste Zeit, einen Baum zu pflanzen, war vor zwanzig Jahren.<br>Die zweitbeste ist <b>jetzt</b>.", "wer": "Sprichwort aus China", "rolle": "", "bild": {"datei": "64.png", "titel": "File:Young trees awaiting planting - geograph.org.uk - 7087472.jpg", "lizenz": "CC BY-SA 2.0", "credit": "Richard Webb", "seite": "https://commons.wikimedia.org/wiki/File%3AYoung_trees_awaiting_planting_-_geograph.org.uk_-_7087472.jpg"}},
 {"nr": 65, "text": "Nicht weil es schwer ist, wagen wir es nicht.<br>Weil wir es nicht <b>wagen</b>, ist es schwer.", "wer": "Seneca", "rolle": "Philosoph, Rom · Epistulae morales 104", "bild": {"datei": "65.png", "titel": "File:Bust of Lucius Annaeus Seneca-Busts of philosophers in Sanssouci.jpg", "lizenz": "CC BY-SA 4.0", "credit": "Yair Haklai", "seite": "https://commons.wikimedia.org/wiki/File%3ABust_of_Lucius_Annaeus_Seneca-Busts_of_philosophers_in_Sanssouci.jpg"}},
 {"nr": 66, "text": "Allein können wir so wenig,<br><b>gemeinsam</b> so viel.", "wer": "Helen Keller", "rolle": "Schriftstellerin, USA", "bild": {"datei": "66.png", "titel": "File:Helen Keller circa 1920 - restored.jpg", "lizenz": "Public domain", "credit": "Los Angeles Times; restored by User:Rhododendrites", "seite": "https://commons.wikimedia.org/wiki/File%3AHelen_Keller_circa_1920_-_restored.jpg"}},
 {"nr": 67, "text": "Im Leben ist nichts zu <b>fürchten</b>,<br>es ist nur zu <b>verstehen</b>.", "wer": "Marie Curie", "rolle": "Physikerin und Chemikerin, zwei Nobelpreise", "bild": {"datei": "67.png", "titel": "File:Marie Curie c. 1920s.jpg", "lizenz": "Public domain", "credit": "Henri Manuel", "seite": "https://commons.wikimedia.org/wiki/File%3AMarie_Curie_c._1920s.jpg"}},
 {"nr": 68, "text": "Gestern war ich klug und wollte die Welt verändern.<br>Heute bin ich weise und verändere <b>mich selbst</b>.", "wer": "Rumi", "rolle": "Dichter, Persien, 13. Jh.", "bild": {"datei": "68.png", "titel": "File:Meeting of Jalal al-Din Rumi and Molla Shams al-Din.jpg", "lizenz": "Public domain", "credit": "Unknown authorUnknown author", "seite": "https://commons.wikimedia.org/wiki/File%3AMeeting_of_Jalal_al-Din_Rumi_and_Molla_Shams_al-Din.jpg"}},
 {"nr": 69, "text": "Ruhige See macht keinen <b>geschickten</b> Seemann.", "wer": "Sprichwort aus Ostafrika", "rolle": "", "bild": {"datei": "69.jpg", "titel": "File:Zanzibar 2012 06 05 4427 (7592143670).jpg", "lizenz": "CC BY-SA 2.0", "credit": "Harvey Barrison from Massapequa, NY, USA", "seite": "https://commons.wikimedia.org/wiki/File%3AZanzibar_2012_06_05_4427_%287592143670%29.jpg"}},
 {"nr": 70, "text": "Wende dein Gesicht der <b>Sonne</b> zu,<br>dann fallen die Schatten hinter dich.", "wer": "Sprichwort der Māori", "rolle": "Aotearoa · Neuseeland", "bild": {"datei": "70.png", "titel": "File:Lake Sylvester during the sunrise, Kahurangi, New Zealand.jpg", "lizenz": "CC BY-SA 4.0", "credit": "Michal Klajban", "seite": "https://commons.wikimedia.org/wiki/File%3ALake_Sylvester_during_the_sunrise%2C_Kahurangi%2C_New_Zealand.jpg"}},
 {"nr": 71, "text": "Ein Buch ist ein <b>Garten</b>,<br>den man in der Tasche trägt.", "wer": "Arabisches Sprichwort", "rolle": "", "bild": {"datei": "71.png", "titel": "File:Closeup of old books in the library.jpg", "lizenz": "CC BY 2.0", "credit": "Shixart1985", "seite": "https://commons.wikimedia.org/wiki/File%3ACloseup_of_old_books_in_the_library.jpg"}},
 {"nr": 72, "text": "Ich bin nicht gescheitert.<br>Ich kenne jetzt <b>10.000 Wege</b>, die nicht funktionieren.", "wer": "Thomas Edison", "rolle": "Erfinder, USA", "bild": {"datei": "72.png", "titel": "File:Edison and phonograph edit2.jpg", "lizenz": "Public domain", "credit": "Levin C. Handy (per http://hdl.loc.gov/loc.pnp/cwpbh.04326)", "seite": "https://commons.wikimedia.org/wiki/File%3AEdison_and_phonograph_edit2.jpg"}},
 {"nr": 73, "text": "Wissen ist ein <b>Schatz</b>,<br>der seinem Besitzer überallhin folgt.", "wer": "Sprichwort aus China", "rolle": "", "bild": {"datei": "73.jpg", "titel": "File:Bamboo Slips of Qin Dynasty Unearthed from Shuihudi 2013-01.JPG", "lizenz": "CC BY-SA 3.0", "credit": "猫猫的日记本", "seite": "https://commons.wikimedia.org/wiki/File%3ABamboo_Slips_of_Qin_Dynasty_Unearthed_from_Shuihudi_2013-01.JPG"}},
 {"nr": 74, "text": "Der <b>Anfang</b> ist die Hälfte des Ganzen.", "wer": "Aristoteles", "rolle": "Philosoph, Griechenland", "bild": {"datei": "74.png", "titel": "File:Aristotle Altemps Inv8575.jpg", "lizenz": "Public domain", "credit": "After Lysippos", "seite": "https://commons.wikimedia.org/wiki/File%3AAristotle_Altemps_Inv8575.jpg"}},
 {"nr": 75, "text": "Lernen ist wie Rudern gegen den Strom:<br>wer aufhört, <b>treibt zurück</b>.", "wer": "Sprichwort aus China", "rolle": "", "bild": {"datei": "75.jpg", "titel": "File:Varanasi, India, Rowing the boat on river Ganges.jpg", "lizenz": "CC BY 4.0", "credit": "Vyacheslav Argenberg", "seite": "https://commons.wikimedia.org/wiki/File%3AVaranasi%2C_India%2C_Rowing_the_boat_on_river_Ganges.jpg"}},
 {"nr": 76, "text": "Die beste Art, die Zukunft vorauszusagen,<br>ist, sie zu <b>erfinden</b>.", "wer": "Alan Kay", "rolle": "Informatiker, USA", "bild": {"datei": "76.jpg", "titel": "File:Alan Kay (3097597186) (cropped).jpg", "lizenz": "CC BY 2.0", "credit": "Marcin Wichary from San Francisco, U.S.A.", "seite": "https://commons.wikimedia.org/wiki/File%3AAlan_Kay_%283097597186%29_%28cropped%29.jpg"}},
 {"nr": 77, "text": "Der Geist ist kein Gefäß, das gefüllt,<br>sondern ein <b>Feuer</b>, das entzündet werden will.", "wer": "Plutarch", "rolle": "Philosoph, Griechenland", "bild": {"datei": "77.jpg", "titel": "File:Campfire flames at night.jpg", "lizenz": "CC BY-SA 4.0", "credit": "Marc-Lautenbacher", "seite": "https://commons.wikimedia.org/wiki/File%3ACampfire_flames_at_night.jpg"}},
 {"nr": 78, "text": "Es <b>irrt</b> der Mensch, solang er <b>strebt</b>.", "wer": "Johann Wolfgang von Goethe", "rolle": "Faust · Prolog im Himmel", "bild": {"datei": "78.jpg", "titel": "File:Goethe in the Roman Campagna (SM 1157).png", "lizenz": "PDM-owner", "credit": "Johann Heinrich Wilhelm Tischbein", "seite": "https://commons.wikimedia.org/wiki/File%3AGoethe_in_the_Roman_Campagna_%28SM_1157%29.png", "zugeschnitten": "Sicherung: ~/.claude/projects/-Users-malvers-IdeaProjects-forloop/memory/handoff-files/weisheiten/bilder-beschnitten/"}},
 {"nr": 79, "text": "Nicht <b>wenig Zeit</b> haben wir,<br>sondern viel Zeit vergeuden wir.", "wer": "Seneca", "rolle": "Philosoph, Rom · De brevitate vitae", "bild": {"datei": "79.jpg", "titel": "File:Wooden hourglass 3.jpg", "lizenz": "CC BY-SA 3.0", "credit": "User:S Sepp", "seite": "https://commons.wikimedia.org/wiki/File%3AWooden_hourglass_3.jpg"}},
 {"nr": 80, "text": "<b>Phantasie</b> ist wichtiger als Wissen.", "wer": "Albert Einstein", "rolle": "Physiker", "bild": {"datei": "80.jpg", "titel": "File:Albert Einstein 1921 by F Schmutzer.jpg", "lizenz": "Public domain", "credit": "Ferdinand Schmutzer", "seite": "https://commons.wikimedia.org/wiki/File%3AAlbert_Einstein_1921_by_F_Schmutzer.jpg"}},
 {"nr": 81, "text": "Nichts ist so mächtig wie eine <b>Idee</b>,<br>deren Zeit gekommen ist.", "wer": "Victor Hugo", "rolle": "Schriftsteller, Frankreich", "bild": {"datei": "81.jpg", "titel": "File:Victor Hugo by Étienne Carjat 1876 - full.jpg", "lizenz": "Public domain", "credit": "Étienne Carjat", "seite": "https://commons.wikimedia.org/wiki/File%3AVictor_Hugo_by_%C3%89tienne_Carjat_1876_-_full.jpg"}},
 {"nr": 82, "text": "Der Mensch ist nur da ganz Mensch,<br>wo er <b>spielt</b>.", "wer": "Friedrich Schiller", "rolle": "Über die ästhetische Erziehung, 15. Brief", "bild": {"datei": "82.jpg", "titel": "File:Anton Graff - Friedrich Schiller.jpg", "lizenz": "Public domain", "credit": "Anton Graff", "seite": "https://commons.wikimedia.org/wiki/File%3AAnton_Graff_-_Friedrich_Schiller.jpg"}},
 {"nr": 83, "text": "Man sieht nur mit dem <b>Herzen</b> gut.<br>Das Wesentliche ist für die Augen unsichtbar.", "wer": "Antoine de Saint-Exupéry", "rolle": "Der kleine Prinz", "bild": {"datei": "83.jpg", "titel": "File:Starry night at the Atacama Desert coast (gerd huedepohl 9).jpg", "lizenz": "CC BY 4.0", "credit": "G. Hüdepohl (atacamaphoto.com)/ESO", "seite": "https://commons.wikimedia.org/wiki/File%3AStarry_night_at_the_Atacama_Desert_coast_%28gerd_huedepohl_9%29.jpg"}},
 {"nr": 84, "text": "Der <b>gestirnte Himmel</b> über mir<br>und das <b>moralische Gesetz</b> in mir.", "wer": "Immanuel Kant", "rolle": "Kritik der praktischen Vernunft", "bild": {"datei": "84.jpg", "titel": "File:036 Milky Way during Perseids seen from Oeschinensee with water reflections Photo by Giles Laurent.jpg", "lizenz": "CC BY-SA 4.0", "credit": "Giles Laurent", "seite": "https://commons.wikimedia.org/wiki/File%3A036_Milky_Way_during_Perseids_seen_from_Oeschinensee_with_water_reflections_Photo_by_Giles_Laurent.jpg"}},
 {"nr": 85, "text": "Ich weiß, dass ich <b>nichts weiß</b>.", "wer": "Sokrates", "rolle": "überliefert von Platon, Athen", "bild": {"datei": "85.jpg", "titel": "File:Socrate du Louvre.jpg", "lizenz": "CC BY-SA 2.5", "credit": "Copy of Lysippos (?)", "seite": "https://commons.wikimedia.org/wiki/File%3ASocrate_du_Louvre.jpg"}},
 {"nr": 86, "text": "Sag es mir, und ich vergesse es.<br>Zeig es mir, und ich erinnere mich.<br><b>Lass es mich tun</b>, und ich verstehe.", "wer": "Sprichwort aus China", "rolle": "Xunzi zugeschrieben", "bild": {"datei": "86.jpg", "titel": "File:The Wheel (135616779).jpeg", "lizenz": "CC BY 3.0", "credit": "Stephanie Pakrul", "seite": "https://commons.wikimedia.org/wiki/File%3AThe_Wheel_%28135616779%29.jpeg"}},
 {"nr": 87, "text": "<b>Mut</b> steht am Anfang des Handelns,<br>Glück am Ende.", "wer": "Demokrit", "rolle": "Philosoph, Griechenland", "bild": {"datei": "87.jpg", "titel": "File:5698. Bust of Democritus in the Summer Garden.jpg", "lizenz": "CC BY-SA 4.0", "credit": "GAlexandrova", "seite": "https://commons.wikimedia.org/wiki/File%3A5698._Bust_of_Democritus_in_the_Summer_Garden.jpg"}},
 {"nr": 88, "text": "Wer ein einziges Leben rettet,<br>rettet eine <b>ganze Welt</b>.", "wer": "Mischna", "rolle": "Sanhedrin 4,5", "bild": {"datei": "88.jpg", "titel": "File:A Candle in the Dark.jpeg", "lizenz": "CC BY-SA 3.0", "credit": "Leoadec", "seite": "https://commons.wikimedia.org/wiki/File%3AA_Candle_in_the_Dark.jpeg"}},
 {"nr": 89, "text": "Wenn ich nicht für mich bin, wer ist für mich?<br>Und wenn ich <b>nur</b> für mich bin, was bin ich?", "wer": "Hillel", "rolle": "Pirkei Avot 1,14", "bild": {"datei": "89.jpg", "titel": "File:Torah scroll writing.jpg", "lizenz": "CC BY-SA 3.0", "credit": "Liran1977", "seite": "https://commons.wikimedia.org/wiki/File%3ATorah_scroll_writing.jpg"}},
 {"nr": 90, "text": "Steter Tropfen <b>höhlt den Stein</b> —<br>nicht mit Gewalt, sondern durch Beständigkeit.", "wer": "Ovid", "rolle": "Dichter, Rom", "bild": {"datei": "90.jpg", "titel": "File:Santa Ana de Pusa (2006) 06.jpg", "lizenz": "CC BY-SA 4.0", "credit": "LBM1948", "seite": "https://commons.wikimedia.org/wiki/File%3ASanta_Ana_de_Pusa_%282006%29_06.jpg"}},
 {"nr": 91, "text": "Wer <b>kämpft</b>, kann verlieren.<br>Wer nicht kämpft, hat schon verloren.", "wer": "Bertolt Brecht", "rolle": "Dichter", "bild": {"datei": "91.jpg", "titel": "File:Bertolt-Brecht.jpg", "lizenz": "CC BY-SA 3.0 de", "credit": "Kolbe, Jörg", "seite": "https://commons.wikimedia.org/wiki/File%3ABertolt-Brecht.jpg"}},
 {"nr": 92, "text": "Ein Schiff im Hafen ist sicher.<br>Aber <b>dafür</b> werden Schiffe nicht gebaut.", "wer": "John A. Shedd", "rolle": "Salt from My Attic, 1928", "bild": {"datei": "92.jpg", "titel": "File:Sails of the Seven Seas - Melbourne International Tall Ship Festival 2013 (9727270297).jpg", "lizenz": "CC BY 2.0", "credit": "Chris Phutully from Australia", "seite": "https://commons.wikimedia.org/wiki/File%3ASails_of_the_Seven_Seas_-_Melbourne_International_Tall_Ship_Festival_2013_%289727270297%29.jpg"}},
 {"nr": 93, "text": "Wer andere kennt, ist klug.<br>Wer <b>sich selbst</b> kennt, ist weise.", "wer": "Laozi", "rolle": "Daodejing 33", "bild": {"datei": "93.jpg", "titel": "File:Glencoe Lochan reflections 3 20211022.jpg", "lizenz": "CC BY-SA 3.0", "credit": "Daniel Kraft", "seite": "https://commons.wikimedia.org/wiki/File%3AGlencoe_Lochan_reflections_3_20211022.jpg"}},
 {"nr": 94, "text": "Wer ist weise?<br>Wer von <b>jedem Menschen</b> lernt.", "wer": "Ben Soma", "rolle": "Pirkei Avot 4,1", "bild": {"datei": "94.jpg", "titel": "File:Claude Lefebvre - A Teacher and his Pupil - WGA12629.jpg", "lizenz": "Public domain", "credit": "Attributed to Claude Lefèbvre", "seite": "https://commons.wikimedia.org/wiki/File%3AClaude_Lefebvre_-_A_Teacher_and_his_Pupil_-_WGA12629.jpg"}},
 {"nr": 95, "text": "Wenn du es <b>eilig</b> hast, mach einen Umweg.", "wer": "Sprichwort aus Japan", "rolle": "急がば回れ · isogaba maware", "bild": {"datei": "95.jpg", "titel": "File:Hairpin bends leading to tourist spot Pir Chinasi.jpg", "lizenz": "CC BY-SA 4.0", "credit": "Obaid Hassan Qureshi", "seite": "https://commons.wikimedia.org/wiki/File%3AHairpin_bends_leading_to_tourist_spot_Pir_Chinasi.jpg"}},
 {"nr": 96, "text": "Nichts ist beständiger als der <b>Wandel</b>.", "wer": "Heraklit", "rolle": "Philosoph, Ephesos", "bild": {"datei": "96.jpg", "titel": "File:Chalakudy river rapids near Thumboormuzhi forest range Kerala.jpg", "lizenz": "CC BY-SA 4.0", "credit": "LiteraryDP", "seite": "https://commons.wikimedia.org/wiki/File%3AChalakudy_river_rapids_near_Thumboormuzhi_forest_range_Kerala.jpg"}},
 {"nr": 97, "text": "Die Grenzen meiner <b>Sprache</b><br>sind die Grenzen meiner Welt.", "wer": "Ludwig Wittgenstein", "rolle": "Tractatus logico-philosophicus 5.6", "bild": {"datei": "97.jpg", "titel": "File:Ludwig Wittgenstein ca. 1946.jpg", "lizenz": "Public domain", "credit": "Anonymous", "seite": "https://commons.wikimedia.org/wiki/File%3ALudwig_Wittgenstein_ca._1946.jpg"}},
 {"nr": 98, "text": "Ich bin, <b>weil wir sind</b>.", "wer": "Ubuntu · Sprichwort aus dem südlichen Afrika", "rolle": "", "bild": {"datei": "98.jpg", "titel": "File:Women Dancing in a village.jpg", "lizenz": "CC BY-SA 4.0", "credit": "MKwadyo", "seite": "https://commons.wikimedia.org/wiki/File%3AWomen_Dancing_in_a_village.jpg"}},
 {"nr": 99, "text": "Man muss noch <b>Chaos</b> in sich haben,<br>um einen tanzenden Stern zu gebären.", "wer": "Friedrich Nietzsche", "rolle": "Also sprach Zarathustra", "bild": {"datei": "99.jpg", "titel": "File:A starry night, in another galaxy (potw2637a).jpg", "lizenz": "CC BY 4.0", "credit": "ESO/M.-R. Cioni et al.", "seite": "https://commons.wikimedia.org/wiki/File%3AA_starry_night%2C_in_another_galaxy_%28potw2637a%29.jpg"}},
 {"nr": 100, "text": "Think <b>Big</b>!", "wer": "", "rolle": "Hubble eXtreme Deep Field: fast jeder Lichtpunkt ist eine ganze Galaxie.", "groesse": "riesig", "bild": {"datei": "100.png", "titel": "File:Hubble Extreme Deep Field (full resolution).png", "lizenz": "Public domain", "credit": "NASA, ESA, HUDF09 Team", "seite": "https://commons.wikimedia.org/wiki/File%3AHubble_Extreme_Deep_Field_%28full_resolution%29.png"}}
]
